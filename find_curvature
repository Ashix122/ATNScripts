#!/usr/bin/env python3

import sys
import numpy as np

def main():
    if len(sys.argv) != 2:
        print("Usage: find_curvature <file>")
        sys.exit(1)

    filename = sys.argv[1]

    try:
        data = np.loadtxt(filename, comments="#")
    except Exception as e:
        print(f"Error reading file: {e}")
        sys.exit(1)

    time = data[:, 0]
    curvature = data[:, 1]
    x = data[:, 2]
    y = data[:, 3]
    z = data[:, 4]

    idx = np.argmax(curvature)

    print("Maximum curvature:", curvature[idx])
    print("Position (x, y, z):", (x[idx], y[idx], z[idx]))
    print("Time:", time[idx])

if __name__ == "__main__":
    main()
